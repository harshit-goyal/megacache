MEGACACHE_HOST=0.0.0.0
MEGACACHE_PORT=8080
MEGACACHE_RESP_HOST=0.0.0.0
MEGACACHE_RESP_PORT=6380
MEGACACHE_CLI_HOST=127.0.0.1
MEGACACHE_CLI_PORT=6380
MEGACACHE_CLI_USERNAME=
MEGACACHE_CLI_PASSWORD=
MEGACACHE_CLI_TLS=false
# MEGACACHE_CLI_CA_FILE=/path/to/ca.pem
# MEGACACHE_CLI_SERVER_NAME=cache.example.com
MEGACACHE_MAX_ENTRIES=10000
MEGACACHE_MAX_MEMORY_BYTES=67108864
MEGACACHE_MAX_ENTRY_BYTES=1048576
MEGACACHE_MAX_BODY_BYTES=1048576
MEGACACHE_DEFAULT_TTL_SECONDS=300
MEGACACHE_DEFAULT_STALE_SECONDS=900
MEGACACHE_LEASE_SECONDS=30
MEGACACHE_SHUTDOWN_GRACE_SECONDS=10
MEGACACHE_NODE_ID=node-1
MEGACACHE_CLUSTER_NODES=node-1
MEGACACHE_REPLICA_COUNT=1
MEGACACHE_VIRTUAL_NODES=128
MEGACACHE_CONSISTENCY=majority
MEGACACHE_HEARTBEAT_INTERVAL_SECONDS=2
MEGACACHE_HEARTBEAT_TIMEOUT_SECONDS=10
MEGACACHE_SNAPSHOT_PAYLOAD_LIMIT_BYTES=67108864
MEGACACHE_SNAPSHOT_CHUNK_BYTES=262144
MEGACACHE_SNAPSHOT_MAX_IN_FLIGHT=2
MEGACACHE_MAX_RETAINED_TOMBSTONES=10000
# MEGACACHE_ORIGINS_FILE=/path/to/origins.json
MEGACACHE_ORIGIN_WORKER_THREADS=2
MEGACACHE_ORIGIN_REFRESH_QUEUE_SIZE=1000
MEGACACHE_ORIGIN_GLOBAL_MAX_CONCURRENCY=64
MEGACACHE_ORIGIN_GLOBAL_MAX_QUEUE=256
# MEGACACHE_EVENTS_FILE=/path/to/events.json
MEGACACHE_EVENT_STATE_FILE=megacache-events-state.json
MEGACACHE_EVENT_MAX_SEEN=10000
MEGACACHE_EVENT_MAX_REPLAY_TOKENS=10000
MEGACACHE_EVENT_MAX_DEAD_LETTERS=1000
MEGACACHE_EVENT_MAX_DEAD_LETTER_BYTES=8388608
MEGACACHE_EVENT_MAX_STREAMS=1000
MEGACACHE_EVENT_MAX_STATE_BYTES=16777216
MEGACACHE_EVENT_MAX_PAYLOAD_BYTES=1048576
MEGACACHE_EVENT_MAX_CURSOR_BYTES=4096
MEGACACHE_EVENT_MAX_ERROR_BYTES=4096
MEGACACHE_EVENT_GRAPH_MAX_NODES=10000
MEGACACHE_EVENT_GRAPH_MAX_EDGES=50000
MEGACACHE_EVENT_GRAPH_MAX_FANOUT=100
MEGACACHE_EVENT_GRAPH_MAX_DEPTH=16
MEGACACHE_EVENT_GRAPH_MAX_INVALIDATION_NODES=10000
# Conservative cache intelligence is disabled by default.
MEGACACHE_INTELLIGENCE_ENABLED=false
MEGACACHE_ADAPTIVE_TTL_ENABLED=false
MEGACACHE_INTELLIGENCE_MIN_TTL_SECONDS=5
MEGACACHE_INTELLIGENCE_MAX_TTL_SECONDS=3600
MEGACACHE_INTELLIGENCE_MAX_KEYS=10000
MEGACACHE_INTELLIGENCE_MAX_CLASSES=128
# Keep lru for compatibility; set cost only after dry-run validation.
MEGACACHE_EVICTION_POLICY=lru
MEGACACHE_HOT_KEY_THRESHOLD=100
MEGACACHE_HOT_KEY_WINDOW_SECONDS=60
MEGACACHE_HOT_KEY_EXTRA_REPLICAS=1
MEGACACHE_EXPERIMENT_ENABLED=false
MEGACACHE_EXPERIMENT_ID=adaptive-ttl-v1
MEGACACHE_EXPERIMENT_ALLOCATION_PERCENT=0
MEGACACHE_EXPERIMENT_MIN_SAMPLES=100
MEGACACHE_EXPERIMENT_MAX_MISS_REGRESSION=0.05
MEGACACHE_INTELLIGENCE_STATE_FILE=megacache-intelligence-state.json
# MEGACACHE_CATALOG_WEBHOOK_SECRET=replace-with-at-least-16-bytes
# MEGACACHE_API_KEY=replace-me
# MEGACACHE_USERS_FILE=/path/to/users.json
# MEGACACHE_TLS_CERT_FILE=/path/to/server-cert.pem
# MEGACACHE_TLS_KEY_FILE=/path/to/server-key.pem
